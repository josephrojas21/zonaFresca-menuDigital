# Local development defaults to SQLite if DATABASE_URL is absent.
PORT=3007
DATABASE_FILE=.data/zona-fresca.sqlite
# Optional local / REQUIRED Vercel: restricted web role, never database owner.
# DATABASE_URL=postgresql://zona_fresca_web_app:REPLACE@HOST/neondb?sslmode=verify-full
# Optional exact origin; otherwise same-origin is checked using the request host.
# APP_ORIGIN=https://your-domain.example
# VERCEL_ENV is set by Vercel; preview uses the separate QA schema.
